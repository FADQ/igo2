{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "interne": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "interne",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": false,
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "defaultConfiguration": "development",
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "aot": true,
            "outputPath": {
              "base": "dist/interne"
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "src/tsconfig.interne.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/config",
              "src/contexts",
              "src/locale",
              {
                "glob": "**/*",
                "input": "./node_modules/@igo2/common/assets/",
                "output": "./assets/igo2/common/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@igo2/core/assets/",
                "output": "./assets/igo2/core/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@igo2/core/theming/prebuilt-themes",
                "output": "./assets/igo2/core/theming/prebuilt-themes"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@igo2/geo/assets/",
                "output": "./assets/igo2/geo/"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/style/partial",
                "node_modules"
              ]
            },
            "allowedCommonJsDependencies": [
              "angular2-notifications",
              "hammerjs",
              "ngx-cacheable",
              "typy",
              "jspdf",
              "file-saver",
              "jszip",
              "jwt-decode",
              "@turf/helpers",
              "@turf/union",
              "@turf/truncate",
              "pbf",
              "geojson-rbush",
              "minimatch",
              "path",
              "pixelworks",
              "brace-expansion",
              "rbush",
              "@babel/runtime-corejs3",
              "core-js-pure",
              "raf",
              "txml",
              "lru-cache",
              "striptags",
              "nosleep.js",
              "ts-md5",
              "moment",
              "html2canvas",
              "jszip",
              "rgbcolor",
              "rbush"
            ],
            "browser": "src/apps/interne.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/interne/environment.ts",
                  "with": "src/environments/interne/environment.prod.ts"
                }
              ],
              "optimization": {
                  "scripts": true,
                  "styles": true,
                  "fonts": {
                    "inline": false
                  }
                },
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true
            },
            "development": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false,
              "namedChunks": true
            }
          }
        },
        "serve": {
          "defaultConfiguration": "development",
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "buildTarget": "interne:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "interne:build:production"
            },
            "development": {
              "buildTarget": "interne:build:development"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "interne:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": ["src/styles.scss"],
            "scripts": [],
            "assets": ["src/favicon.ico", "src/assets"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/apps/interne/**/*.ts",
              "src/apps/interne/**/*.html"
            ]
          }
        }
      }
    },
    "lib": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/lib/**/*.ts",
              "src/lib/**/*.html"
            ]
          }
        }
      }
    },
